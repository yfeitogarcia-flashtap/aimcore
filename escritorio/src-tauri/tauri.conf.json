{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vektor",
  "version": "0.4.0",
  "identifier": "com.flicklab.vektor",
  "build": {
    "frontendDist": "../ventana"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Vektor",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "center": true,
        "url": "https://ancient-violet-678.fly.dev/",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 VektorEscritorio/0.4"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "principal"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "FlickLAB",
    "copyright": "Vektor Installer 0.4.0 · FlickLAB",
    "shortDescription": "Aim trainer y duelo 1v1",
    "longDescription": "Vektor by FlickLAB. Ventana nativa del juego desplegado.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "instalador/cabecera.bmp",
        "sidebarImage": "instalador/lateral.bmp",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
